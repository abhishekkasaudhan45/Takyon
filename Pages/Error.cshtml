@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="section-padding section-bg-white text-center">
  <div class="container py-5">
    <div class="rounded-circle bg-danger-subtle text-danger p-3 border shadow-sm mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
      <i class="bi bi-exclamation-triangle-fill fs-1"></i>
    </div>
    <h1 class="display-6 fw-bold text-navy mb-2">Unexpected Request Error</h1>
    <p class="text-muted mb-4">An error occurred while processing your request. Please return to the home page.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-4">
          <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-page="/Index" class="btn btn-takyon-primary px-4 py-2">
      <i class="bi bi-house-door-fill me-1"></i> Return to Home
    </a>
  </div>
</section>
