@page
@model Takyon.Pages.Industries.IndexModel
@{
    ViewData["Title"] = "Industries Served — Tailored Digital Infrastructure Across 12 Verticals";
}

<partial name="_HeroSection" model='("Industry Verticals We Serve", "Tailored IT infrastructure solutions addressing the unique regulatory and operational needs of diverse sectors.", "Industries")' />

<section class="section-padding section-bg-white">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Cross-Sector Expertise</span>
      <h2 class="section-title">One Technology Partner. Multiple Industries.</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        At Takyon Networks, we align technology with sector-specific operational priorities to create secure, scalable, and compliant solutions that deliver measurable value.
      </p>
    </div>

    <div class="row g-4">
      @foreach (var ind in Model.Industries)
      {
          <div class="col-md-6 col-lg-4" id="@ind.Id">
            <div class="p-4 rounded-4 border bg-light h-100 d-flex flex-column hover-shadow transition-all">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-white text-primary p-3 border shadow-sm fs-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                  <i class="bi @ind.Icon"></i>
                </div>
                <div>
                  <span class="badge bg-primary-subtle text-primary border small">Vertical @ind.DisplayOrder.ToString("D2")</span>
                  <h4 class="h5 fw-bold text-navy mb-0">@ind.Name</h4>
                </div>
              </div>

              <p class="text-muted small mb-4">@ind.Description</p>

              <div class="mt-auto pt-3 border-top">
                <h6 class="small fw-bold text-navy text-uppercase mb-2">Key Scopes & Deployments:</h6>
                <div class="d-flex flex-wrap gap-1">
                  @foreach (var area in ind.FocusAreas)
                  {
                      <span class="badge bg-white text-dark border small p-2">
                        <i class="bi bi-check2 text-success me-1"></i> @area
                      </span>
                  }
                </div>
              </div>
            </div>
          </div>
      }
    </div>
  </div>
</section>

<!-- Sector Value Banner -->
<section class="section-padding section-bg-light border-top">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <h3 class="fw-bold text-navy mb-2">Government & Enterprise Sector Procurement</h3>
        <p class="text-muted mb-0">
          Takyon is empaneled with major public undertakings including UPDESCO, UPPCL, RailTel, UPRNN, and registered on GeM (Government e-Marketplace), enabling government departments and PSUs to engage us directly with assured compliance.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a asp-page="/Projects/Index" class="btn btn-takyon-primary">
          View Relevant Projects <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
    </div>
  </div>
</section>
