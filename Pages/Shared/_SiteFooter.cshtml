@inject ITakyonContentProvider ContentProvider
@{
    var overview = ContentProvider.GetCompanyOverview();
    var offices = ContentProvider.GetOfficeContacts();
    var coreSolutions = ContentProvider.GetSolutions(coreOnly: true);
}

<footer class="takyon-footer" role="contentinfo">
  <div class="container">
    <div class="row g-4">
      <!-- Col 1: About & Credentials -->
      <div class="col-lg-4 col-md-6">
        <div class="mb-3">
          <img src="~/images/brand/takyon-logo.png" alt="Takyon Networks Limited Logo" style="height: 48px; background: white; padding: 4px 10px; border-radius: 6px;" />
        </div>
        <p class="text-light opacity-75 small mb-3">
          Takyon Networks Limited is a BSE-listed system integrator and IT infrastructure solutions provider, delivering innovative, reliable and scalable technology solutions across India since 2009.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <span class="badge bg-secondary-subtle text-light border border-light-subtle small px-2 py-1">
            <i class="bi bi-patch-check-fill text-warning me-1"></i> BSE Listed (Aug 2025)
          </span>
          <span class="badge bg-secondary-subtle text-light border border-light-subtle small px-2 py-1">
            <i class="bi bi-award-fill text-success me-1"></i> CMMI Level 3
          </span>
          <span class="badge bg-secondary-subtle text-light border border-light-subtle small px-2 py-1">
            <i class="bi bi-shield-check text-info me-1"></i> GeM Registered
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="col-lg-2 col-md-6 col-6">
        <h5>Quick Links</h5>
        <ul>
          <li><a asp-page="/Index">Home</a></li>
          <li><a asp-page="/About/Index">About Us</a></li>
          <li><a asp-page="/Leadership/Index">Leadership Team</a></li>
          <li><a asp-page="/Services/Index">Services & Solutions</a></li>
          <li><a asp-page="/Industries/Index">Industries Served</a></li>
          <li><a asp-page="/Projects/Index">Notable Projects</a></li>
          <li><a asp-page="/Clients/Index">Client Portfolio</a></li>
          <li><a asp-page="/Partners/Index">OEM Alliances</a></li>
          <li><a asp-page="/Contact/Index">Contact Us</a></li>
        </ul>
      </div>

      <!-- Col 3: Core IT Solutions -->
      <div class="col-lg-3 col-md-6 col-6">
        <h5>Core Solutions</h5>
        <ul>
          @foreach (var sol in coreSolutions)
          {
              <li><a asp-page="/Services/Index" asp-fragment="@sol.Id">@sol.Title</a></li>
          }
        </ul>
      </div>

      <!-- Col 4: Corporate Offices & Newsletter Demo -->
      <div class="col-lg-3 col-md-6">
        <h5>Contact Details</h5>
        <div class="small opacity-75 mb-3">
          <p class="mb-1"><strong class="text-white">Headquarters:</strong><br />CP-37, Viraj Khand-4, Gomti Nagar, Lucknow - 226010, Uttar Pradesh</p>
          <p class="mb-1"><i class="bi bi-telephone-fill me-1 text-info"></i> (0522) 665 6617</p>
          <p class="mb-2"><i class="bi bi-envelope-fill me-1 text-info"></i> info@takyon.co.in</p>
          <p class="mb-1"><strong class="text-white">Delhi NCR:</strong> Tel: (011) 4560 5725<br />
            <span class="text-warning small fst-italic">(Address withheld pending confirmation)</span>
          </p>
        </div>

        <h5 class="mt-4">Stay Connected</h5>
        <form id="newsletterForm" novalidate>
          <div class="input-group input-group-sm mb-2">
            <input type="email" id="newsletterEmail" class="form-control" placeholder="Enter corporate email" aria-label="Enter corporate email for newsletter" required />
            <button class="btn btn-takyon-primary" type="submit">Subscribe</button>
            <div class="invalid-feedback text-warning small">Please enter a valid email address.</div>
          </div>
          <div id="newsletterSuccess" class="alert alert-success py-1 px-2 small d-none" role="alert">
            <i class="bi bi-info-circle-fill me-1"></i> Frontend validation passed. Prototype mode: no subscription saved.
          </div>
          <div class="form-text text-light opacity-50 small">
            Demonstration interface only. No personal data is stored.
          </div>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="takyon-footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <div>
        &copy; 2026 Takyon Networks Limited. All rights reserved. | BSE-Listed Company | CMMI Level 3 Appraised
      </div>
      <div class="small opacity-75">
        <span>Headquarters: Lucknow, Uttar Pradesh</span> &bull; 
        <a asp-page="/Contact/Index" class="text-light text-decoration-none ms-1">Office Directory</a>
      </div>
    </div>
  </div>
</footer>
