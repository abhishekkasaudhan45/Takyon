@page
@model Takyon.Pages.About.IndexModel
@{
    ViewData["Title"] = "About Us — Company Background, Mission, Vision & Milestones";
}

<partial name="_HeroSection" model='("About Takyon Networks Limited", "Enabling digital transformation through passion for integration and 15+ years of infrastructure delivery excellence.", "About Us")' />

<!-- Overview Section -->
<section class="section-padding section-bg-white">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="section-tag">Who We Are</span>
        <h2 class="section-title">Enabling Digital Transformation. Delivering Lasting Impact.</h2>
        <div class="accent-bar"></div>
        @foreach (var p in Model.Overview.OverviewParagraphs)
        {
            <p class="text-muted mb-3">@p</p>
        }
        <div class="d-flex flex-wrap gap-2 mt-4">
          <span class="badge bg-primary-subtle text-primary border px-3 py-2 fw-semibold">Founded 2009</span>
          <span class="badge bg-success-subtle text-success border px-3 py-2 fw-semibold">BSE Listed (Aug 2025)</span>
          <span class="badge bg-info-subtle text-info-emphasis border px-3 py-2 fw-semibold">CMMI Level 3 Appraised</span>
          <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">Pan-India Delivery</span>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card border-0 shadow rounded-4 overflow-hidden">
          <img src="~/images/brand/takyon-hq-building.jpg" alt="Takyon Headquarters Building" class="img-fluid" />
          <div class="p-3 bg-light text-center small text-muted border-top">
            <strong>Takyon Networks Limited Corporate Office</strong> &bull; Lucknow, Uttar Pradesh
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mission & Vision Cards -->
<section class="section-padding section-bg-light">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-6">
        <div class="p-4 rounded-4 bg-white border h-100 shadow-sm d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
              <i class="bi bi-bullseye fs-3"></i>
            </div>
            <h3 class="h4 fw-bold mb-0 text-navy">Our Mission</h3>
          </div>
          <p class="text-muted mb-0 fs-5">
            "@Model.Overview.Mission"
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-4 rounded-4 bg-white border h-100 shadow-sm d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
              <i class="bi bi-eye fs-3"></i>
            </div>
            <h3 class="h4 fw-bold mb-0 text-navy">Our Vision</h3>
          </div>
          <p class="text-muted mb-0 fs-5">
            "@Model.Overview.Vision"
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Core Values Grid -->
<section class="section-padding section-bg-white">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Guiding Principles</span>
      <h2 class="section-title">Our Core Values</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        The principles that guide our relationships with clients, technology partners, employees, and communities.
      </p>
    </div>

    <div class="row g-4">
      @foreach (var val in Model.Overview.CoreValues)
      {
          <div class="col-md-6 col-lg-3">
            <div class="p-4 rounded-3 border bg-light h-100 text-center hover-shadow transition-all">
              <div class="rounded-circle bg-white text-primary p-3 border shadow-sm mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi @val.Icon fs-3"></i>
              </div>
              <h5 class="fw-bold mb-2 text-navy">@val.Title</h5>
              <p class="small text-muted mb-0">@val.Description</p>
            </div>
          </div>
      }
    </div>
  </div>
</section>

<!-- Milestones Timeline -->
<section class="section-padding section-bg-light border-top">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Corporate Journey</span>
      <h2 class="section-title">The Takyon Story: From 2009 to Beyond</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        Key corporate milestones marking over a decade and a half of sustained growth, innovation, and trust.
      </p>
    </div>

    <div class="row g-3">
      @foreach (var m in Model.Overview.Milestones)
      {
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 border p-3 bg-white rounded-3 shadow-sm">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary fs-6 px-3 py-1">@m.Year</span>
                <i class="bi bi-check-circle-fill text-success"></i>
              </div>
              <h5 class="fw-bold text-navy mb-2">@m.Title</h5>
              <p class="small text-muted mb-0">@m.Description</p>
            </div>
          </div>
      }
    </div>
  </div>
</section>

<!-- Government Empanelments -->
<section class="section-padding section-bg-white border-top">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Trusted Credentials</span>
      <h2 class="section-title">Government Empanelments</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        Empanelment ensures comprehensive vendor due diligence has been completed, enabling direct and compliant procurement.
      </p>
    </div>

    <div class="row g-4 justify-content-center">
      @foreach (var emp in Model.Overview.Empanelments)
      {
          <div class="col-md-6 col-lg-4">
            <div class="p-4 rounded-3 border bg-light h-100">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-patch-check-fill text-primary fs-4"></i>
                <h5 class="fw-bold mb-0 text-navy">@emp.Name</h5>
              </div>
              <p class="small text-muted mb-0">@emp.Description</p>
            </div>
          </div>
      }
    </div>
  </div>
</section>

<!-- CTA -->
<section class="container my-5">
  <div class="cta-banner text-center p-5 rounded-4 shadow">
    <h2 class="display-6 fw-bold mb-3 text-white">Partner with Takyon Networks</h2>
    <p class="lead mb-4 text-light opacity-90 mx-auto" style="max-width: 680px;">
      Explore our leadership team, corporate governance, and end-to-end integration capabilities.
    </p>
    <a asp-page="/Leadership/Index" class="btn btn-takyon-green px-4 py-3 fw-bold">
      Meet the Leadership Team <i class="bi bi-arrow-right ms-1"></i>
    </a>
  </div>
</section>
