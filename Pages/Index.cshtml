@page
@model IndexModel
@{
    ViewData["Title"] = "Digital Transformation Partner — IT Infrastructure & Integration";
}

<!-- Hero Section -->
<section class="takyon-hero py-5">
  <div class="container py-lg-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill" style="background-color: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);">
          <span class="text-white fw-semibold small"><i class="bi bi-patch-check-fill text-warning me-1"></i> BSE Listed (Aug 2025)</span>
          <span class="text-white opacity-50">|</span>
          <span class="text-white fw-semibold small"><i class="bi bi-award-fill text-success me-1"></i> CMMI Level 3 Appraised</span>
        </div>
        <h1 class="display-4 fw-bold mb-3 text-white">
          Enabling Digital Transformation.<br />
          <span style="color: #a4e067;">Delivering Lasting Impact.</span>
        </h1>
        <p class="lead mb-4 text-light opacity-90">
          Takyon Networks Limited is a trusted system integrator and IT infrastructure solutions provider, helping government, public sector, and enterprise organizations build secure, agile, and future-ready digital ecosystems.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a asp-page="/Services/Index" class="btn btn-takyon-green px-4 py-3 fw-bold">
            Explore Solutions <i class="bi bi-arrow-right ms-1"></i>
          </a>
          <a asp-page="/Projects/Index" class="btn btn-takyon-outline px-4 py-3 fw-bold text-white border-white">
            Notable Projects
          </a>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="position-relative p-2 rounded-4 shadow-lg" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2);">
          <img src="~/images/brand/takyon-hq-building.jpg" alt="Takyon Networks Limited Corporate Headquarters" class="img-fluid rounded-3 w-100 shadow" style="max-height: 420px; object-fit: cover;" />
          <div class="p-3 text-center text-white">
            <span class="fw-bold">Corporate Headquarters</span> &bull; <span class="small opacity-75">Lucknow, Uttar Pradesh</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Credibility Metrics Bar -->
<section class="section-padding section-bg-light border-bottom">
  <div class="container">
    <div class="row g-4 justify-content-center">
      <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box">
          <div class="stat-number">15+</div>
          <div class="stat-label">Years of Trust</div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box">
          <div class="stat-number">1,000+</div>
          <div class="stat-label">Projects Delivered</div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box">
          <div class="stat-number">400+</div>
          <div class="stat-label">Client Engagements</div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box">
          <div class="stat-number">150+</div>
          <div class="stat-label">IT Professionals</div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box">
          <div class="stat-number">40+</div>
          <div class="stat-label">OEM Alliances</div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box">
          <div class="stat-number">12</div>
          <div class="stat-label">Industry Verticals</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Company Overview / The Takyon Advantage -->
<section class="section-padding section-bg-white">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="section-tag">Inside Takyon</span>
        <h2 class="section-title">Passion for Integration. Delivering End-to-End IT Infrastructure.</h2>
        <div class="accent-bar"></div>
        <p class="text-muted mb-4">
          Headquartered in Lucknow and operating across India, Takyon Networks Limited translates complex operational priorities into dependable infrastructure. From structured campus connectivity and cyber security to state-wide optical networks and resilient data centers, we take complete turnkey accountability.
        </p>
        <div class="row g-3 mb-4">
          <div class="col-sm-6">
            <div class="d-flex align-items-start gap-3 p-3 rounded bg-light border">
              <i class="bi bi-shield-check text-primary fs-3"></i>
              <div>
                <h6 class="fw-bold mb-1">CMMI Level 3 Appraised</h6>
                <small class="text-muted">Rigorous delivery governance and process maturity.</small>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-start gap-3 p-3 rounded bg-light border">
              <i class="bi bi-bank2 text-primary fs-3"></i>
              <div>
                <h6 class="fw-bold mb-1">BSE Listed Company</h6>
                <small class="text-muted">Audited financials, transparency, and board-level governance.</small>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-start gap-3 p-3 rounded bg-light border">
              <i class="bi bi-patch-check text-primary fs-3"></i>
              <div>
                <h6 class="fw-bold mb-1">Government Empanelments</h6>
                <small class="text-muted">UPDESCO, UPPCL, GeM Portal, RailTel, UPRNN.</small>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-start gap-3 p-3 rounded bg-light border">
              <i class="bi bi-headset text-primary fs-3"></i>
              <div>
                <h6 class="fw-bold mb-1">24/7 SLA Support</h6>
                <small class="text-muted">On-ground support network and rapid SLA resolution.</small>
              </div>
            </div>
          </div>
        </div>
        <a asp-page="/About/Index" class="btn btn-takyon-primary">
          Read Company Story <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm p-4 rounded-4" style="background: linear-gradient(135deg, #f8fbfd 0%, #eef5fa 100%); border: 1px solid #dce4ea;">
          <h4 class="fw-bold mb-4 text-navy"><i class="bi bi-compass-fill text-primary me-2"></i>Takyon Core Pillars</h4>
          <ul class="list-unstyled mb-0">
            <li class="d-flex gap-3 mb-3 pb-3 border-bottom">
              <span class="badge bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">T</span>
              <div>
                <h6 class="fw-bold mb-1">Transforming Your Workplace</h6>
                <p class="small text-muted mb-0">Enabling connected, productive workplaces through practical IT solutions.</p>
              </div>
            </li>
            <li class="d-flex gap-3 mb-3 pb-3 border-bottom">
              <span class="badge bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">A</span>
              <div>
                <h6 class="fw-bold mb-1">Competitive-Edge to Your Business</h6>
                <p class="small text-muted mb-0">Technology choices that help teams work smarter and respond faster.</p>
              </div>
            </li>
            <li class="d-flex gap-3 mb-3 pb-3 border-bottom">
              <span class="badge bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">K</span>
              <div>
                <h6 class="fw-bold mb-1">Key Solutions for Network & Integration</h6>
                <p class="small text-muted mb-0">Connecting infrastructure, devices and systems into a coordinated environment.</p>
              </div>
            </li>
            <li class="d-flex gap-3 mb-3 pb-3 border-bottom">
              <span class="badge bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">Y</span>
              <div>
                <h6 class="fw-bold mb-1">Your Digital Transformation Partner</h6>
                <p class="small text-muted mb-0">Helping organizations modernize processes and leverage reliable digital technology.</p>
              </div>
            </li>
            <li class="d-flex gap-3 mb-3 pb-3 border-bottom">
              <span class="badge bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">O</span>
              <div>
                <h6 class="fw-bold mb-1">One Stop Solution</h6>
                <p class="small text-muted mb-0">Comprehensive coverage across planning, deployment, and ongoing support.</p>
              </div>
            </li>
            <li class="d-flex gap-3">
              <span class="badge bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">N</span>
              <div>
                <h6 class="fw-bold mb-1">Nurturing Your Business</h6>
                <p class="small text-muted mb-0">Responsive support and lifecycle care as requirements evolve.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Core 6 IT Solutions Section -->
<section class="section-padding section-bg-light">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Core Offerings</span>
      <h2 class="section-title">The 6 Core IT Solutions</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        Defined in Takyon's corporate service portfolio, delivering integrated, future-ready infrastructure for institutional resilience.
      </p>
    </div>

    <div class="row g-4">
      @foreach (var solution in Model.CoreSolutions)
      {
          <div class="col-md-6 col-lg-4">
            <div class="takyon-card">
              <div class="solution-card-body">
                <div class="solution-icon-wrapper">
                  <i class="bi @solution.Icon"></i>
                </div>
                <span class="solution-badge">Core Solution</span>
                <h3 class="solution-title">@solution.Title</h3>
                <p class="small text-muted mb-3">@solution.Summary</p>
                <div class="border-top pt-3 mt-3">
                  <h6 class="small fw-bold text-navy mb-2">Key Scopes:</h6>
                  <ul class="solution-list">
                    @foreach (var sub in solution.SubServices)
                    {
                        <li>@sub</li>
                    }
                  </ul>
                </div>
              </div>
              <div class="p-3 bg-light border-top text-end">
                <a asp-page="/Services/Index" asp-fragment="@solution.Id" class="small fw-bold text-primary text-decoration-none">
                  View Architecture Details <i class="bi bi-chevron-right"></i>
                </a>
              </div>
            </div>
          </div>
      }
    </div>

    <div class="text-center mt-5">
      <a asp-page="/Services/Index" class="btn btn-takyon-primary px-4 py-2">
        View All Services & Specialized Solutions <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>
  </div>
</section>

<!-- Industry Verticals -->
<section class="section-padding section-bg-white">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Domain Expertise</span>
      <h2 class="section-title">Industry Verticals We Serve</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        Deep domain experience across 12 sectors, aligning technology with mission-critical organizational objectives.
      </p>
    </div>

    <div class="row g-4">
      @foreach (var ind in Model.FeaturedIndustries)
      {
          <div class="col-md-6 col-lg-4">
            <div class="p-4 rounded-3 border bg-light h-100 transition-all hover-shadow">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-white p-3 border shadow-sm text-primary fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                  <i class="bi @ind.Icon"></i>
                </div>
                <h5 class="fw-bold mb-0 text-navy">@ind.Name</h5>
              </div>
              <p class="small text-muted mb-3">@ind.Description</p>
              <div class="d-flex flex-wrap gap-1">
                @foreach (var focus in ind.FocusAreas)
                {
                    <span class="badge bg-white text-secondary border small">@focus</span>
                }
              </div>
            </div>
          </div>
      }
    </div>

    <div class="text-center mt-4">
      <a asp-page="/Industries/Index" class="btn btn-takyon-outline">
        View All 12 Industry Verticals <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>
  </div>
</section>

<!-- Selected Notable Projects Highlights -->
<section class="section-padding section-bg-light">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Proven Track Record</span>
      <h2 class="section-title">Selected Notable Projects</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        Verified project execution supported by client scopes and institutional milestones from the A4 brochure.
      </p>
    </div>

    <div class="row g-4">
      @foreach (var proj in Model.FeaturedProjects)
      {
          <div class="col-md-6 col-lg-4">
            <div class="takyon-card">
              <img src="@proj.ImagePath" alt="@proj.Title" class="project-card-image" />
              <div class="project-card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="project-number">PROJECT @proj.ProjectNumber</span>
                  <span class="badge bg-info-subtle text-primary-emphasis small">@proj.Industry</span>
                </div>
                <h4 class="h5 fw-bold mb-2">@proj.Title</h4>
                <div class="project-client-badge mb-2">
                  <i class="bi bi-building me-1"></i> @proj.Client
                </div>
                <p class="project-scope mb-0">
                  <strong>Scope:</strong> @proj.Scope
                </p>
              </div>
            </div>
          </div>
      }
    </div>

    <div class="text-center mt-5">
      <a asp-page="/Projects/Index" class="btn btn-takyon-primary px-4 py-2">
        Explore All Case Studies & Projects <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>
  </div>
</section>

<!-- Technology Partners Preview -->
<section class="section-padding section-bg-white border-top">
  <div class="container">
    <div class="section-heading text-center">
      <span class="section-tag">Technology Ecosystem</span>
      <h2 class="section-title">Trusted Global OEM Alliances</h2>
      <div class="accent-bar centered"></div>
      <p class="section-desc mx-auto">
        Collaborating with 40+ leading OEMs to architect best-of-breed enterprise IT solutions with direct manufacturer support.
      </p>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
      @foreach (var partner in Model.FeaturedPartners)
      {
          <div class="col">
            <div class="logo-card">
              <img src="@partner.LogoPath" alt="@partner.AltText" class="logo-img" />
            </div>
          </div>
      }
    </div>

    <div class="text-center mt-4">
      <a asp-page="/Partners/Index" class="btn btn-takyon-outline">
        View All OEM Alliances <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="container my-5">
  <div class="cta-banner text-center p-5 rounded-4 shadow">
    <h2 class="display-6 fw-bold mb-3 text-white">Ready to Modernize Your Digital Infrastructure?</h2>
    <p class="lead mb-4 text-light opacity-90 mx-auto" style="max-width: 680px;">
      Connect with our engineering specialists in Lucknow, Delhi, and Kolkata to evaluate your requirements and architect future-ready IT infrastructure.
    </p>
    <a asp-page="/Contact/Index" class="btn btn-takyon-green px-4 py-3 fw-bold fs-5">
      Get in Touch with Takyon <i class="bi bi-arrow-right ms-1"></i>
    </a>
  </div>
</section>
